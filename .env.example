# Kopieer naar .env (lokaal) en vul in. Zet hier NOOIT echte geheimen in en commit .env nooit.

# Database
DATABASE_URL=postgres://coach:coach_dev@localhost:5432/toolbox_coach

# Geheimen: genereer elk met bijvoorbeeld `openssl rand -base64 32`
SESSIE_GEHEIM=vervang-mij-door-een-lange-willekeurige-waarde
PSEUDONIEM_GEHEIM=vervang-mij-door-een-andere-lange-willekeurige-waarde

# Inloggen: "nep" = testgebruikers (proof of concept)
AUTH_MODUS=nep

# Coach: "hermes" = Hermes Agent, "mock" = zonder AI, "uit" = geen coach (alles handmatig)
COACH_MODUS=mock
COACH_TIMEOUT_MS=30000

# Alleen bij COACH_MODUS=hermes (zie docs/hermes.md)
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=vervang-mij-door-de-API_SERVER_KEY-van-het-hermes-profiel
HERMES_MODEL=toolbox-coach

# Bewaartermijnen
BEWAARTERMIJN_MAANDEN=12
CONCEPT_BEWAARDAGEN=30

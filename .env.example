# Kopieer naar .env (lokaal) en vul in. Zet hier NOOIT echte geheimen in en commit .env nooit.

# Database
DATABASE_URL=postgres://coach:coach_dev@localhost:5432/toolbox_coach

# Geheimen: genereer elk met bijvoorbeeld `openssl rand -base64 32`
SESSIE_GEHEIM=vervang-mij-door-een-lange-willekeurige-waarde
PSEUDONIEM_GEHEIM=vervang-mij-door-een-andere-lange-willekeurige-waarde

# Inloggen: "nep" = testgebruikers (proof of concept), "entra" = Microsoft Entra ID / Teams-SSO
AUTH_MODUS=nep
# Alleen bij AUTH_MODUS=entra (zie docs/teams.md); dit zijn id's, geen geheimen
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_APP_ID_URI=api://coach.voorbeeld.invalid/<client-id>
ENTRA_STANDAARD_ROL=medewerker
# Sessiecookie geschikt voor een iframe in Teams (standaard aan bij AUTH_MODUS=entra)
# SESSIE_IN_IFRAME=true

# Coach: "hermes" = Hermes Agent, "mock" = zonder AI, "uit" = geen coach (alles handmatig)
COACH_MODUS=mock
COACH_TIMEOUT_MS=30000

# Alleen bij COACH_MODUS=hermes (zie docs/hermes.md)
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=vervang-mij-door-de-API_SERVER_KEY-van-het-hermes-profiel
HERMES_MODEL=toolbox-coach

# Map met de content (regelset, tools, spelregels, teksten). Standaard ./content
# CONTENT_DIR=./content

# Bewaartermijnen
BEWAARTERMIJN_MAANDEN=12
CONCEPT_BEWAARDAGEN=30

# Vervolgacties (zie docs/acties.md)
# "mock" = alleen loggen; "webhook" = de flows van IJK aanroepen
ACTIE_MODUS=mock
ACTIE_ACCOUNT_URL=http://127.0.0.1:8650/account
ACTIE_TOETSING_URL=http://127.0.0.1:8650/toetsing
ACTIE_MELDING_URL=http://127.0.0.1:8650/melding
# Rood zonder alternatief: melding aan Team Digitale Ontwikkeling (status "contact volgt")
ACTIE_CONTACT_URL=http://127.0.0.1:8650/contact
ACTIE_GEHEIM=vervang-mij-door-een-lang-willekeurig-geheim
ACTIE_GEHEIM_HEADER=X-IJK-Webhook-Secret
ACTIE_TIMEOUT_MS=10000
# Naam en e-mailadres van de aanvrager opslaan, zodat toetsers en beheerders zien wie een aanvraag indiende
# (standaard aan). Gaat nooit naar de coach. Zet op false om alleen het pseudoniem op te slaan.
AANVRAGER_OPSLAAN=true
# Stuur de UPN van de aanvrager mee (standaard uit: alleen pseudoniem)
ACTIE_STUUR_UPN=false
# Publieke adres van de app, voor links in meldingen
APP_URL=http://localhost:3000
